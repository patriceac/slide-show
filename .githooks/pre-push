#!/usr/bin/env sh

zero_sha="0000000000000000000000000000000000000000"
protected_ref="refs/heads/main"

while read local_ref local_sha remote_ref remote_sha
do
    local_sha=$(printf '%s' "$local_sha" | tr -d '\r')
    remote_sha=$(printf '%s' "$remote_sha" | tr -d '\r')

    if [ "$remote_ref" != "$protected_ref" ]; then
        continue
    fi

    if [ "$local_sha" = "$zero_sha" ]; then
        echo "Push rejected: deleting main is blocked by the local repository hook." >&2
        exit 1
    fi

    if [ "$remote_sha" = "$zero_sha" ]; then
        continue
    fi

    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "Push rejected: main would rewrite remote history." >&2
        echo "Pull the remote changes first, then push a fast-forward update." >&2
        exit 1
    fi
done

exit 0
